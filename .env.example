# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# VAPID Key for Firebase Cloud Messaging (Web Push)
# Get this in: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# Service Account credentials (for sending push notifications via FCM V1 API)
# Get this in: Firebase Console > Project Settings > Service Accounts > Generate new private key
VITE_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
VITE_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...your_key...\n-----END PRIVATE KEY-----\n"

# Google Drive API Key (for gallery feature)
VITE_GOOGLE_API_KEY=your_google_api_key
